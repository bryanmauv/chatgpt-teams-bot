{
  "name": "chatgpt-teams-bot",
  "type": "module",
  "version": "2.0.0",
  "description": "Microsoft Teams Bot with Multi-AI Provider Support (OpenAI, Anthropic, Google, Ollama)",
  "author": "Bryan Mauv",
  "license": "MIT",
  "main": "./lib/index.js",
  "scripts": {
    "dev": "tsc && shx cp -r ./adaptiveCards ./lib/ && nodemon --watch 'index.ts' --watch 'providers/**/*.ts' --watch 'config.ts' --watch 'teamsBot.ts' --ext ts --exec 'tsc && node ./lib/index.js'",
    "build": "tsc --build && shx cp -r ./adaptiveCards ./lib/",
    "start": "node ./lib/index.js",
    "watch": "nodemon --exec \"npm run start\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.8.0",
    "@microsoft/adaptivecards-tools": "^1.0.0",
    "botbuilder": "^4.22.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "ollama": "^0.5.0",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0"
  }
}
