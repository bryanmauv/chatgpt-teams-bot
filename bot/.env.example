# ============================================
# Configuration Azure AD (Microsoft Entra)
# ============================================
# Configuration requise pour connecter le bot à Microsoft Teams
#
# ÉTAPES DE CONFIGURATION:
# 1. Allez sur https://entra.microsoft.com
# 2. Rubrique "Applications d'entreprise" → "Nouvelle inscription"
# 3. Notez votre Application (client) ID et Directory (tenant) ID
# 4. Configurez l'authentification:
#    - Ajouter une Redirect URI: https://localhost:3978/api/messages
#    - ou pour production: https://votre-domaine.com/api/messages
# 5. Créez un secret client dans "Certificats et secrets"

# Application (client) ID (obligatoire)
# Trouvé dans: Azure Portal → Enregistrements d'applications → Votre app → Vue d'ensemble
MICROSOFT_APP_ID=00000000-0000-0000-0000-000000000000

# Client Secret (obligatoire)
# Créé dans: Azure Portal → Enregistrements d'applications → Votre app → Certificats et secrets
MICROSOFT_APP_PASSWORD=votre-secret-client

# Directory (tenant) ID (optionnel, mais recommandé)
# Trouvé dans: Azure Portal → Enregistrements d'applications → Votre app → Vue d'ensemble
MICROSOFT_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# Port du serveur (optionnel, défaut: 3978)
PORT=3978

# ============================================
# Configuration du Provider d'IA
# ============================================
# Choisissez votre provider d'IA: 'openai', 'anthropic', 'google', 'ollama'
AI_PROVIDER=openai

# ============================================
# Configuration OpenAI (ChatGPT)
# ============================================
# Créez votre clé API sur: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-votre-cle-api-openai
OPENAI_MODEL=gpt-3.5-turbo
# Modèles disponibles: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo-16k
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ============================================
# Configuration Anthropic (Claude)
# ============================================
# Créez votre clé API sur: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-votre-cle-api-anthropic
ANTHROPIC_MODEL=claude-3-sonnet-20240229
# Modèles disponibles:
# - claude-3-opus-20240229 (le plus puissant)
# - claude-3-sonnet-20240229 (équilibré)
# - claude-3-haiku-20240307 (le plus rapide)
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2000

# ============================================
# Configuration Google (Gemini)
# ============================================
# Créez votre clé API sur: https://makersuite.google.com/app/apikey

GOOGLE_API_KEY=votre-cle-api-google
GOOGLE_MODEL=gemini-pro
# Modèles disponibles: gemini-pro, gemini-pro-vision
GOOGLE_TEMPERATURE=0.7
GOOGLE_MAX_TOKENS=2000

# ============================================
# Configuration Ollama (Modèles Locaux)
# ============================================
# Ollama permet d'exécuter des modèles d'IA en local (gratuit)
# Installation: https://ollama.ai/
# Télécharger un modèle: ollama pull llama2

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
# Modèles populaires (télécharger avec 'ollama pull <model>'):
# - llama2, llama3 (Meta Llama)
# - mistral, mixtral (Mistral AI)
# - codellama (Code spécialisé)
# - phi (Microsoft)
# - gemma (Google)
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
